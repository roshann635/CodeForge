# Server Port
PORT=5000

# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/codeforge

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Judge0 CE API Configuration (RapidAPI or Self-Hosted)
JUDGE0_HOST=judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_judge0_key_here
# Optional: Self-hosted Judge0 URL (e.g. http://localhost:2358)
# JUDGE0_URL=http://localhost:2358

# Admin & Faculty Passkey
ADMIN_KEY=codeforge_admin_2026

# Google Gemini API Key (For AI Review & Voice Evaluation)
GEMINI_API_KEY=your_gemini_api_key_here

# Nodemailer Configuration (Gmail SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password