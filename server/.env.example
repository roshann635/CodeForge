# Server Port
PORT=5000

# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/codeforge

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here

# --- Option A: Self-hosted Judge0 (recommended for college deployment) ---
# Start locally: cd judge0 && ./start.sh  (or start.ps1 on Windows)
JUDGE0_URL=http://localhost:2358
JUDGE0_AUTH_TOKEN=codeforge_judge0_local_token
JUDGE0_AUTH_HEADER=X-Auth-Token

# --- Option B: RapidAPI hosted Judge0 (quick demo, 50 submissions/day free) ---
# JUDGE0_HOST=judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=your_rapidapi_judge0_key_here

# Use async token+poll instead of wait=true (recommended for production)
# JUDGE0_ASYNC=true

# Admin & Faculty Passkey
ADMIN_KEY=codeforge_admin_2026

# Google Gemini API Key (For AI Review & Voice Evaluation)
GEMINI_API_KEY=your_gemini_api_key_here

# Nodemailer Configuration (Gmail SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password